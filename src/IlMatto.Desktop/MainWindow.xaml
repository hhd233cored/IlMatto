<Window x:Class="IlMatto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IlMatto.Desktop.Controls"
        Title="IlMatto · Pi Coding Agent" Width="1440" Height="900" MinWidth="1040" MinHeight="680"
        Background="#F8FAFC" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ControlTemplate x:Key="NoHoverButtonTemplate" TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="NoHoverToggleButtonTemplate" TargetType="ToggleButton">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
    </ControlTemplate>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#273244" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template" Value="{StaticResource NoHoverButtonTemplate}" />
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#273244" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template" Value="{StaticResource NoHoverToggleButtonTemplate}" />
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#253044" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="HistoryListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Container" CornerRadius="8" Padding="4" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Container" Property="Background" Value="#DCE8F5" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Container" Property="Background" Value="#E4EDF7" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProcessExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ToggleButton x:Name="HeaderToggle" Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Focusable="False">
                  <ContentPresenter ContentSource="Header" />
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Grid.Row="1" ContentSource="Content" Margin="0,5,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditedFileRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Menu Grid.Row="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10,0">
      <MenuItem Header="文件">
        <MenuItem Header="新建对话" Command="{Binding NewSessionCommand}" />
        <Separator />
        <MenuItem Header="退出" Click="ExitMenuItem_OnClick" />
      </MenuItem>
      <MenuItem Header="编辑" />
      <MenuItem Header="视图" />
      <MenuItem Header="设置" Click="SettingsMenuItem_OnClick" />
      <MenuItem Header="帮助" />
    </Menu>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="286" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="0,0,1,0">
        <Grid Margin="16,14,14,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="4,2,2,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <TextBlock Text="IlMatto" FontSize="22" FontWeight="SemiBold" Foreground="#172033" />
              <TextBlock Text="  ·  Pi" FontSize="13" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
            <Button Grid.Column="1" Content="☰" ToolTip="收起侧栏" Style="{StaticResource SidebarButton}" HorizontalContentAlignment="Center" Width="38" />
          </Grid>
          <Button Grid.Row="1" Content="＋  新对话" Command="{Binding NewSessionCommand}" Style="{StaticResource SidebarButton}" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="12,11" />
          <ListBox Grid.Row="2" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource HistoryListItem}" Margin="0,12,0,12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="5,3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="◌" FontSize="15" Foreground="#64748B" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Margin="2,0,4,0">
                    <TextBlock Text="{Binding Title}" Foreground="#253044" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Foreground="#8A98AA" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="⋯" ToolTip="删除对话" Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SidebarButton}" Padding="7,0" Margin="0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" BorderBrush="#D6E1ED" BorderThickness="0,1,0,0" Padding="4,14,4,0">
            <StackPanel>
              <TextBlock Text="当前工作区" FontSize="11" Foreground="#718096" />
              <TextBlock Text="{Binding WorkspacePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}" Foreground="#334155" Margin="0,5,0,0" />
              <Button Content="⚙  设置" Click="SettingsMenuItem_OnClick" Style="{StaticResource SidebarButton}" Margin="-7,10,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#FBFCFE">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding ProcessPanelWidth}" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E6EBF1" BorderThickness="0,0,0,1" Padding="28,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="▣" FontSize="18" Foreground="#64748B" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentConversationTitle}" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#718096" VerticalAlignment="Center" Margin="20,0,10,0" />
            <TextBlock Grid.Column="2" Text="{Binding ContextMetricsLabel}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Content="{Binding ProcessPanelToggleGlyph}" Command="{Binding ToggleProcessPanelCommand}" ToolTip="展开/隐藏过程栏" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#64748B" Padding="8,4" />
            <Button Grid.Column="4" Content="⚙" Click="SettingsMenuItem_OnClick" ToolTip="设置" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#64748B" />
          </Grid>
        </Border>

        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,0,16">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" CanContentScroll="False" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ChatScrollViewer_OnScrollChanged" PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel">
            <ListBox ItemsSource="{Binding ChatEntries}" BorderThickness="0" Background="Transparent" Margin="54,24,54,18" HorizontalContentAlignment="Stretch">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,6" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="12" Padding="16,13" BorderBrush="#E5EAF0" BorderThickness="1" Background="#FFFFFF">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Role}" Value="你"><Setter Property="Background" Value="#EAF2FD" /><Setter Property="BorderBrush" Value="#D4E3F7" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="#536174" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding Segments}" Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <local:MarkdownViewer Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" Markdown="{Binding Text}" Foreground="#172033" FontSize="14" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,6" />
                              <Expander Visibility="{Binding HasVisibleOperations, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MaxWidth="900" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                                <Expander.Header>
                                  <Grid MinHeight="22" MaxWidth="900" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding LatestOperation.DisplayTitle}" Foreground="#6B7280" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420" />
                                    <TextBlock Grid.Column="2" Text="{Binding LatestOperation.CommandPreview}" ToolTip="{Binding LatestOperation.CommandLine}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding LatestOperation.Status}" Foreground="#9CA3AF" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" />
                                  </Grid>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,4">
                                  <TextBlock Text="{Binding LatestOperation.Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="900" HorizontalAlignment="Left" />
                                  <ItemsControl ItemsSource="{Binding PreviousOperations}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Expander Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MaxWidth="900" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                                          <Expander.Header>
                                            <Grid MinHeight="22" MaxWidth="900" HorizontalAlignment="Left">
                                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                              <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                              <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="#6B7280" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420" />
                                              <TextBlock Grid.Column="2" Text="{Binding CommandPreview}" ToolTip="{Binding CommandLine}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" />
                                              <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#9CA3AF" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                          </Expander.Header>
                                          <TextBlock Text="{Binding Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="900" HorizontalAlignment="Left" Margin="0,4,0,4" />
                                        </Expander>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Expander>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Visibility="{Binding HasEditedFiles, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="900" HorizontalAlignment="Stretch" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0" Padding="10,8">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="▣" FontSize="16" Foreground="#64748B" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding EditedFilesSummary}" FontWeight="SemiBold" Foreground="#253044" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding EditedFiles}" HorizontalContentAlignment="Stretch" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Style="{StaticResource EditedFileRowButton}">
                                  <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Path}" Foreground="#536174" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Added, StringFormat=+{0}}" Foreground="#16A34A" TextAlignment="Right" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{Binding Removed, StringFormat=-{0}}" Foreground="#DC2626" TextAlignment="Right" FontFamily="Consolas" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <Border Grid.Row="1" Visibility="{Binding IsApprovalVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="54,0,54,8" Background="#FFF7DF" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <DockPanel Grid.Row="0">
                <TextBlock Text="需要批准" FontWeight="SemiBold" Foreground="#7C5A00" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding PendingApproval.Summary}" FontWeight="SemiBold" Foreground="#253044" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Grid.Row="1" Text="{Binding PendingApproval.DisplayDetails}" Foreground="#334155" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="180" />
              <TextBox Grid.Row="2" Text="{Binding PendingApproval.FieldsJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,8,0,0" Padding="6" Background="#FFFDF5">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PendingApproval.HasFields}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <TextBox Grid.Row="3" Text="{Binding PendingApproval.Diff}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" MaxHeight="180" Margin="0,8,0,0" Padding="6" Background="#FFFBEB" BorderBrush="#E8C35A">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PendingApproval.Diff}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      <DataTrigger Binding="{Binding PendingApproval.Diff}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="批准后 Agent 才会继续执行此操作" Foreground="#8A6A19" FontSize="12" />
                  <TextBlock Text="{Binding PendingApprovalQueueLabel}" Foreground="#A16207" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="拒绝" Command="{Binding RejectToolCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="批准一次" Background="#2563EB" Foreground="White" Command="{Binding ApproveToolCommand}" Margin="8,0,0,0" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="2" Visibility="{Binding IsCommandMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="54,0,54,8" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="12" Padding="5">
            <ListBox ItemsSource="{Binding FilteredSlashCommands}" BorderThickness="0" Background="Transparent" MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.ChooseSlashCommandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="9,7">
                    <DockPanel>
                      <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#1D4ED8" />
                      <TextBlock Text="{Binding Description}" Margin="12,0,0,0" Foreground="#64748B" />
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Grid.Row="3" Margin="54,0,54,0" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="16" Padding="16,10,12,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="120" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="14" ToolTip="描述要完成的编码任务" />
              <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ApprovalModeLabel}" Foreground="#718096" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <Button Grid.Column="2" Content="发送  ↑" Command="{Binding SendCommand}" Background="#2563EB" Foreground="White" MinWidth="92" />
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsProcessPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#F3F6FA" BorderBrush="#E1E8F0" BorderThickness="1,0,0,0" Padding="8,10,8,10">
          <TabControl BorderThickness="0" Background="Transparent">
            <TabItem Header="过程">
              <ScrollViewer x:Name="ProcessScrollViewer" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Processes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Expander Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="7,5">
                        <Expander.Header>
                          <Grid MinWidth="250" MaxWidth="285" Height="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="#253044" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="110" />
                            <TextBlock Grid.Column="2" Text="{Binding CommandPreview}" ToolTip="{Binding CommandLine}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#2563EB" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                          </Grid>
                        </Expander.Header>
                        <Border Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="0,8,0,1">
                          <TextBlock Text="{Binding Details}" Foreground="#536174" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" />
                        </Border>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Git">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel" Margin="0,8,0,0">
                <StackPanel>
                  <Border Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="8" Padding="9">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding GitStatusMessage}" FontWeight="SemiBold" Foreground="#253044" TextWrapping="Wrap" DockPanel.Dock="Left" />
                        <Button Content="刷新" Command="{Binding RefreshGitCommand}" Padding="7,3" Margin="6,0,0,0" DockPanel.Dock="Right" />
                      </DockPanel>
                      <TextBlock Text="{Binding GitRoot}" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding GitRoot}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding GitBranch}" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,7,0,0" />
                      <TextBlock Text="{Binding GitTracking}" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <Expander Header="暂存的变更" IsExpanded="True" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ListBox ItemsSource="{Binding StagedGitChanges}" SelectedItem="{Binding SelectedGitFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" MaxHeight="140">
                      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding DisplayStatus}" Foreground="#16A34A" FontWeight="SemiBold" Width="22" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                  <Expander Header="未暂存的变更" IsExpanded="True" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ListBox ItemsSource="{Binding UnstagedGitChanges}" SelectedItem="{Binding SelectedGitFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" MaxHeight="140">
                      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding DisplayStatus}" Foreground="#D97706" FontWeight="SemiBold" Width="22" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                  <Expander Header="未跟踪文件" IsExpanded="False" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ListBox ItemsSource="{Binding UntrackedGitChanges}" SelectedItem="{Binding SelectedGitFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" MaxHeight="140">
                      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding DisplayStatus}" Foreground="#64748B" FontWeight="SemiBold" Width="22" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>

                  <Border Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="Diff" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                          <Button Content="工作区" Command="{Binding ShowWorkingGitDiffCommand}" Padding="6,2" Margin="3,0,0,0" />
                          <Button Content="暂存区" Command="{Binding ShowStagedGitDiffCommand}" Padding="6,2" Margin="3,0,0,0" />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Text="Diff 已截断" Foreground="#B45309" FontSize="11" Margin="0,4,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding GitDiffTruncated}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <TextBox Text="{Binding GitDiffText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" MinHeight="90" MaxHeight="250" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>

                  <Expander Header="本地分支" IsExpanded="False" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ItemsControl ItemsSource="{Binding GitBranches}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Upstream}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Expander>
                  <Expander Header="最近提交" IsExpanded="False" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ItemsControl ItemsSource="{Binding GitCommits}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" /><TextBlock Text="{Binding Author}" Foreground="#64748B" FontSize="10" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Expander>
                  <Expander Header="本地远端配置" IsExpanded="False" Visibility="{Binding IsGitRepository, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Style="{StaticResource ProcessExpander}" Background="#FFFFFF" BorderBrush="#E1E8F0" BorderThickness="1" Padding="8">
                    <ItemsControl ItemsSource="{Binding GitRemotes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="0,2" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
