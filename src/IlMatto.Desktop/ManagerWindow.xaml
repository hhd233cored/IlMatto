<Window x:Class="IlMatto.Desktop.ManagerWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IlMatto.Desktop.Controls"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="{Binding CurrentCompanionTitle}" Width="1280" Height="960" MinWidth="1080" MinHeight="700"
        Background="#F5F6F8" WindowStartupLocation="Manual" PreviewKeyDown="Window_OnPreviewKeyDown">
  <Window.Resources>
    <local:WidthRatioConverter x:Key="MessageMaxWidthConverter"/>
    <DropShadowEffect x:Key="HistoryItemHoverShadow" Color="#6B7280" BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
    <DropShadowEffect x:Key="SelectorHoverShadow" Color="#6B7280" BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
    <ControlTemplate x:Key="NoHoverButtonTemplate" TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="BorderlessEmojiTextBoxTemplate" TargetType="{x:Type emoji:TextBox}">
      <emoji:RichTextBox x:Name="RichTextBox_INTERNAL"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Background="Transparent"
                         FocusVisualStyle="{x:Null}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         FontStretch="{TemplateBinding FontStretch}"
                         FontStyle="{TemplateBinding FontStyle}"
                         FontWeight="{TemplateBinding FontWeight}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                         Padding="{TemplateBinding Padding}"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </ControlTemplate>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template" Value="{StaticResource NoHoverButtonTemplate}"/>
      <Style.Triggers>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE3EC"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ChatHistoryList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="28,28,28,18"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <!-- Dragging the thumb moves the chat immediately; Markdown stays cached and
           the virtualizing panel limits the amount of UI created at once. -->
      <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <!-- Keep one viewport ready on either side so normal drag scrolling does
           not need to construct every newly visible chat bubble synchronously. -->
      <Setter Property="VirtualizingPanel.CacheLength" Value="1,1"/>
      <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
      <!-- Let the battle-tested WPF panel own its pixel offset and extent. -->
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChatHistoryItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmojiTileButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="EmojiTileBackground" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EmojiTileBackground" Property="Background" Value="#F2F3F5"/><Setter TargetName="EmojiTileBackground" Property="Effect" Value="{StaticResource HistoryItemHoverShadow}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="EmojiTileBackground" Property="Background" Value="#E2E7EE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmojiCategoryButton" TargetType="Button" BasedOn="{StaticResource EmojiTileButton}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style x:Key="InlineSelectorItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#273244"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBackground" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#F2F3F5"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#ECEEF1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="InlineSelectorOptionTemplate">
      <StackPanel>
        <TextBlock Text="{Binding DisplayName}" Foreground="#273244" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="ProcessToggleButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ProcessHeaderBackground" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ProcessHeaderBackground" Property="Background" Value="#EEF0F2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ProcessHeaderBackground" Property="Background" Value="#E3E6EA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InlineSelectorToggleButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InlineSelector" TargetType="ComboBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource InlineSelectorItem}"/>
      <Setter Property="ItemTemplate" Value="{StaticResource InlineSelectorOptionTemplate}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="DropDownToggle" Style="{StaticResource InlineSelectorToggleButton}" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Border x:Name="SelectorPill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{TemplateBinding Tag}" Foreground="#718096" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </ToggleButton>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Top" PlacementTarget="{Binding ElementName=DropDownToggle}" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" VerticalOffset="-6" PopupAnimation="Fade">
                <Border Background="#FFFFFF" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="16" Padding="14" MinWidth="300" MaxWidth="390">
                  <StackPanel>
                    <TextBlock Text="{TemplateBinding ToolTip}" Foreground="#6B7280" FontSize="13" VerticalAlignment="Center" Margin="2,0,2,9"/>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorPill" Property="Background" Value="#ECEEF1"/><Setter TargetName="SelectorPill" Property="BorderBrush" Value="#D2D6DC"/><Setter TargetName="SelectorPill" Property="Effect" Value="{StaticResource SelectorHoverShadow}"/></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="SelectorPill" Property="Background" Value="#ECEEF1"/><Setter TargetName="SelectorPill" Property="BorderBrush" Value="#D2D6DC"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectorPill" Property="BorderBrush" Value="#D2D6DC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectorPill" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AgentModelMenuItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#273244"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ModelItemBackground" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModelItemBackground" Property="Background" Value="#ECEEF1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModelItemBackground" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AgentModelProviderLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,4,4,5"/>
    </Style>
    <Style x:Key="AgentModelSelectorToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="AgentModelPill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AgentModelPill" Property="Background" Value="#ECEEF1"/><Setter TargetName="AgentModelPill" Property="BorderBrush" Value="#D2D6DC"/><Setter TargetName="AgentModelPill" Property="BorderThickness" Value="1"/><Setter TargetName="AgentModelPill" Property="Effect" Value="{StaticResource SelectorHoverShadow}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="AgentModelPill" Property="Background" Value="#ECEEF1"/><Setter TargetName="AgentModelPill" Property="BorderBrush" Value="#D2D6DC"/><Setter TargetName="AgentModelPill" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="AgentModelPill" Property="Background" Value="#E6E8EB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#1498ED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DrawerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style x:Key="HistoryItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="HistoryItemBackground" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryItemBackground" Property="Background" Value="#E8EBEF"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryItemBackground" Property="Background" Value="#F2F3F5"/><Setter TargetName="HistoryItemBackground" Property="Effect" Value="{StaticResource HistoryItemHoverShadow}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProcessExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ProcessToggleButton}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                  <ContentPresenter ContentSource="Header"/>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Grid.Row="1" ContentSource="Content" Margin="0,5,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DrawerListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto" MinHeight="184"/>
    </Grid.RowDefinitions>

    <Border Grid.Column="0" Grid.RowSpan="3" Background="#F1F5F9" BorderBrush="#DCE3EB" BorderThickness="0,0,1,0" Padding="18,22,16,18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="19" Background="#F2A65A">
            <Grid>
              <TextBlock Text="{Binding UserAvatarText}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasUserAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Image Source="{Binding UserAvatarImage}" Stretch="UniformToFill" Margin="1">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasUserAvatar}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding UserId}" FontSize="18" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2" Content="⋯" Style="{StaticResource DrawerButton}" ToolTip="更多"/>
        </Grid>
        <Button Grid.Row="1" Content="＋  新对话" Command="{Binding NewSessionCommand}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,18"/>
        <DockPanel Grid.Row="2" Margin="4,0,4,8">
          <TextBlock Text="会话" Foreground="#758195" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Conversations.Count, StringFormat={}{0}}" Foreground="#A1AAB7" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox Grid.Row="3" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" ItemContainerStyle="{StaticResource HistoryItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="7,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="25" Height="25" CornerRadius="13" Background="#DCE8F5" VerticalAlignment="Top">
                  <TextBlock Text="◌" Foreground="#54708D" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,4,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#273244" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding ListTimestamp, StringFormat={}{0:MM-dd HH:mm}}" Foreground="#8B96A5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="×" ToolTip="删除会话" Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" FontSize="15" Padding="5,2"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="4,16,4,0">
          <Separator/>
          <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Width="40" Height="38" Padding="0" ToolTip="设置"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.Row="0" Background="#F8F9FB" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="✎" Click="RenameConversation_OnClick" Style="{StaticResource DrawerButton}" ToolTip="重命名会话" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding SelectedConversation.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis" MaxWidth="470" VerticalAlignment="Center"/>
            <Ellipse Width="7" Height="7" Fill="#2EBD6B" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="Antigravity 已连接"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="⌘" Command="{Binding OpenPiWorkbenchCommand}" Style="{StaticResource DrawerButton}" ToolTip="打开 Coding 工作台"/>
          <Button Content="☷" Command="{Binding ToggleProcessDrawerCommand}" Style="{StaticResource DrawerButton}" ToolTip="Agent 过程"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Grid.Row="1" Background="#F5F6F8">
      <ListBox x:Name="ManagerChatList" ItemsSource="{Binding ChatTimelineItems, ElementName=RootWindow}" Style="{StaticResource ChatHistoryList}" ItemContainerStyle="{StaticResource ChatHistoryItem}" HorizontalContentAlignment="Stretch" Loaded="ManagerChatList_OnLoaded">
          <ListBox.Resources>
            <DataTemplate x:Key="ManagerChatMessageTemplate">
              <Grid Margin="0,0,0,20" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#ECEEF2" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="{Binding ShowDateSeparator, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{Binding DateSeparatorLabel}" Foreground="#8C949E" FontSize="11"/>
                </Border>
                <Grid x:Name="MessageRow" Grid.Row="1" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                  <Border x:Name="AssistantAvatar" Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#1B78B8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                     <Grid>
                       <TextBlock Text="{Binding AvatarText}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                         <TextBlock.Style>
                           <Style TargetType="TextBlock">
                             <Setter Property="Visibility" Value="Visible"/>
                             <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasAgentAvatar, Source={x:Reference RootWindow}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                           </Style>
                         </TextBlock.Style>
                       </TextBlock>
                       <Image Source="{Binding DataContext.AgentAvatarImage, Source={x:Reference RootWindow}}" Stretch="UniformToFill" Margin="1">
                         <Image.Style>
                           <Style TargetType="Image">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasAgentAvatar, Source={x:Reference RootWindow}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                           </Style>
                         </Image.Style>
                       </Image>
                     </Grid>
                  </Border>
                  <Border x:Name="UserAvatar" Grid.Column="4" Width="34" Height="34" CornerRadius="17" Background="#F2A65A" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,1,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                     <Grid>
                       <TextBlock Text="{Binding DataContext.UserAvatarText, Source={x:Reference RootWindow}}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                         <TextBlock.Style>
                           <Style TargetType="TextBlock">
                             <Setter Property="Visibility" Value="Visible"/>
                             <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUserAvatar, Source={x:Reference RootWindow}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                           </Style>
                         </TextBlock.Style>
                       </TextBlock>
                       <Image Source="{Binding DataContext.UserAvatarImage, Source={x:Reference RootWindow}}" Stretch="UniformToFill" Margin="1">
                         <Image.Style>
                           <Style TargetType="Image">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUserAvatar, Source={x:Reference RootWindow}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                           </Style>
                         </Image.Style>
                       </Image>
                     </Grid>
                  </Border>
                  <StackPanel x:Name="MessageBlock">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Grid.Column" Value="1"/>
                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=MessageRow, Converter={StaticResource MessageMaxWidthConverter}, ConverterParameter=0.6666667}"/>
                        <Setter Property="Margin" Value="0,4,0,0"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsTransientStatus}" Value="True">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="0,0,0,0"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <StackPanel x:Name="MessageHeader" Orientation="Horizontal" Margin="6,0,6,8">
                      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                      <TextBlock Text="{Binding DisplayRole}" Foreground="#4F5965" FontSize="10.5" FontWeight="Normal" TextAlignment="Right"/>
                      <TextBlock Text="{Binding Runtime.DisplayLabel}" Foreground="#8A93A0" FontSize="10.5" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="MessageImages" ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                      <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                          <Setter Property="HorizontalAlignment" Value="Stretch"/>
                          <Setter Property="HorizontalContentAlignment" Value="Left"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Right"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ItemsControl.Style>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <local:DeferredImage ImagePath="{Binding Path}" Width="180" Height="140" Stretch="Uniform" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonUp="Image_OnMouseLeftButtonUp" ToolTip="点击查看原图：{Binding DisplayName}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <local:ContentSizedBorder x:Name="MessageBubble" MaxWidth="{Binding ActualWidth, ElementName=MessageRow, Converter={StaticResource MessageMaxWidthConverter}, ConverterParameter=0.6666667}" BorderThickness="1" CornerRadius="15" Padding="16,12">
                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="#E8F2FF"/><Setter Property="BorderBrush" Value="#C9DFF7"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger><DataTrigger Binding="{Binding HasMessageBody}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Background" Value="#EEF1F5"/><Setter Property="BorderBrush" Value="#EEF1F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/><Setter Property="CornerRadius" Value="11"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                      <Grid>
                        <StackPanel x:Name="StandardMessageContent">
                          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                      <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <!-- Streaming text intentionally stays plain: parsing and
                                   constructing a FlowDocument for every delta is much
                                   more expensive than the delta itself.  The terminal
                                   event switches this back to Markdown in one render. -->
                              <TextBlock Text="{Binding Text}" Foreground="#172033" FontFamily="华文中宋" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,5">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding IsText}" Value="True"/>
                                          <Condition Binding="{Binding DataContext.Entry.IsStreamingText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <local:MarkdownViewer DeferWhileStreaming="{Binding DataContext.Entry.IsStreamingText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Markdown="{Binding Text}" Foreground="#172033" FontSize="14" HorizontalAlignment="Left" Margin="0,0,0,5">
                                <local:MarkdownViewer.Style>
                                  <Style TargetType="local:MarkdownViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding IsText}" Value="True"/>
                                          <Condition Binding="{Binding DataContext.Entry.IsStreamingText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </local:MarkdownViewer.Style>
                              </local:MarkdownViewer>
                              <Expander Visibility="{Binding HasVisibleOperations, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                                <Expander.Header>
                                  <Grid MinHeight="22" MaxWidth="690" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatestOperation.DisplayTitle}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="260"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LatestOperation.CommandPreview}" ToolTip="{Binding LatestOperation.CommandLine}" Foreground="#6B7280" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LatestOperation.Status}" Foreground="#9CA3AF" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                  </Grid>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,4">
                                  <local:MarkdownViewer Markdown="{Binding LatestOperation.Details}" Foreground="#64748B" FontSize="12" MaxWidth="690" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <local:MarkdownViewer.Style>
                                      <Style TargetType="local:MarkdownViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding LatestOperation.IsThinking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </local:MarkdownViewer.Style>
                                  </local:MarkdownViewer>
                                  <TextBlock Text="{Binding LatestOperation.Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="690" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding LatestOperation.IsThinking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <ItemsControl ItemsSource="{Binding PreviousOperations}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Expander Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MaxWidth="690" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                                          <Expander.Header>
                                            <Grid MinHeight="22" MaxWidth="690" HorizontalAlignment="Left">
                                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                              <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                              <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="260"/>
                                              <TextBlock Grid.Column="2" Text="{Binding CommandPreview}" ToolTip="{Binding CommandLine}" Foreground="#6B7280" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#9CA3AF" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                          </Expander.Header>
                                          <Grid Margin="0,4,0,4">
                                            <local:MarkdownViewer Markdown="{Binding Details}" Foreground="#64748B" FontSize="12" MaxWidth="690" HorizontalAlignment="Left">
                                              <local:MarkdownViewer.Style>
                                                <Style TargetType="local:MarkdownViewer">
                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                  <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                  </Style.Triggers>
                                                </Style>
                                              </local:MarkdownViewer.Style>
                                            </local:MarkdownViewer>
                                            <TextBlock Text="{Binding Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="690" HorizontalAlignment="Left">
                                              <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                  <Setter Property="Visibility" Value="Visible"/>
                                                  <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                  </Style.Triggers>
                                                </Style>
                                              </TextBlock.Style>
                                            </TextBlock>
                                          </Grid>
                                        </Expander>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Expander>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border x:Name="ResultCard" Background="#F7FAFD" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CodeResult}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                          <DockPanel><TextBlock Text="Coding Agent 结果" FontWeight="SemiBold" Foreground="#273244"/><TextBlock DockPanel.Dock="Right" Text="{Binding CodeResult.StatusLabel}" Foreground="#2563EB"/></DockPanel>
                          <TextBlock Text="{Binding CodeResult.SummaryForUser}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#273244"/>
                          <ItemsControl ItemsSource="{Binding CodeResult.TechnicalDecisions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Decision}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <ItemsControl ItemsSource="{Binding CodeResult.FilesChanged}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Additions, StringFormat=+{0}}" Foreground="#07851C" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Deletions, StringFormat=-{0}}" Foreground="#DC2626" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <ItemsControl ItemsSource="{Binding CodeResult.Validation}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Command}" FontFamily="Consolas"/><TextBlock Text="{Binding Summary}" Foreground="#64748B"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <ItemsControl ItemsSource="{Binding CodeResult.Questions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#8A5B00"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                      </Border>
                        </StackPanel>
                        <TextBlock x:Name="TransientStatusContent" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#9AA4B2" FontSize="11.5" FontStyle="Italic" MaxWidth="680">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTransientStatus}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                      </Grid>
                  </local:ContentSizedBorder>
                  </StackPanel>
                </Grid>
              </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ChatTimelineSpacerTemplate">
              <Border Height="{Binding Height}" Background="Transparent" IsHitTestVisible="False"/>
            </DataTemplate>
            <DataTemplate x:Key="ChatTimelineMessageTemplate">
              <local:ReservedMessagePresenter Message="{Binding Entry}" ReservedHeight="{Binding ReservedHeight}" RenderContent="{Binding RenderContent}" ContentTemplate="{StaticResource ManagerChatMessageTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" NaturalHeightMeasured="TimelineMessagePresenter_OnNaturalHeightMeasured"/>
            </DataTemplate>
          </ListBox.Resources>
          <ListBox.ItemTemplateSelector>
            <local:ChatTimelineItemTemplateSelector SpacerTemplate="{StaticResource ChatTimelineSpacerTemplate}" MessageTemplate="{StaticResource ChatTimelineMessageTemplate}"/>
          </ListBox.ItemTemplateSelector>
      </ListBox>
    </Grid>

    <Border Grid.Column="1" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0" Padding="24,12,24,18">
      <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Grid>
              <Button x:Name="EmojiButton" Content="☺" Style="{StaticResource IconButton}" Click="EmojiButton_OnClick" ToolTip="插入表情"/>
              <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top" VerticalOffset="-16" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Opened="EmojiPopup_OnOpened">
                <Border Width="460" Height="280" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="14" Padding="10" Effect="{StaticResource SelectorHoverShadow}">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="表情" Foreground="#273244" FontSize="14" FontWeight="SemiBold" Margin="4,2,4,8"/>
                    <ScrollViewer x:Name="EmojiScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                      <StackPanel x:Name="EmojiGroupPanel"/>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <WrapPanel x:Name="EmojiCategoryPanel" HorizontalAlignment="Left"/>
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Border>
              </Popup>
            </Grid>
            <Button Content="✂" Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="暂未实现"/>
            <Button Content="▱" Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="暂未实现"/>
            <Button Content="▣" Style="{StaticResource IconButton}" Command="{Binding PasteImageAttachmentCommand}" ToolTip="粘贴剪贴板图片"/>
            <Button Content="▧" Style="{StaticResource IconButton}" Command="{Binding AddImageAttachmentCommand}" ToolTip="选择图片"/>
            <Button Content="♬" Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="暂未实现"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"/>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingImageAttachments}" Visibility="{Binding HasPendingImageAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4,0,4,7">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="180" Height="140" Margin="0,0,8,6">
                <Border Background="#F2F7FC" BorderBrush="#C9D9E8" BorderThickness="1" CornerRadius="9" Padding="4">
                  <Image Source="{Binding PreviewImage}" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="Image_OnMouseLeftButtonUp" ToolTip="点击查看原图：{Binding DisplayName}"/>
                </Border>
                <Button Content="×" Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveImageAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Background="#FFFFFF" BorderBrush="#C9D9E8" BorderThickness="1" Foreground="#6B7C8D" Padding="0" FontSize="13" ToolTip="移除图片"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="2" Visibility="{Binding HasApproval, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4,0,4,8" Background="#FFF7DF" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="12" Padding="12,10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
              <TextBlock Text="⚠" Foreground="#A16207" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CurrentApproval.Summary}" FontWeight="SemiBold" Foreground="#253044" TextWrapping="Wrap" Margin="9,0,0,0"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding PendingApprovalCountLabel}" Foreground="#A16207" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding CurrentApproval.DisplayDetails}" Foreground="#334155" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="180"/>
            <TextBlock Grid.Row="2" Text="{Binding CurrentApproval.Url}" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBox Grid.Row="3" Text="{Binding CurrentApproval.Diff}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" MaxHeight="150" Margin="0,8,0,0" Padding="6" Background="#FFFBEB" BorderBrush="#E8C35A">
              <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CurrentApproval.Diff}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding CurrentApproval.Diff}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
            </TextBox>
            <TextBox Grid.Row="4" Text="{Binding CurrentApproval.FieldsJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" MaxHeight="90" Margin="0,8,0,0" Background="#FFFDF5">
              <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentApproval.HasFields}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
            </TextBox>
            <TextBox Grid.Row="5" Text="{Binding InteractionResponseText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="90" Margin="0,8,0,0" ToolTip="{Binding CurrentApproval.InputHint}">
              <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentApproval.RequiresInput}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
            </TextBox>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="拒绝" Command="{Binding RejectCommand}" Style="{StaticResource IconButton}" FontSize="12"/>
              <Button Content="批准一次" Style="{StaticResource PrimaryButton}" Background="#2563EB" Foreground="White" Command="{Binding ApproveCommand}" Margin="8,0,0,0" Padding="12,7" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="3" MinHeight="141">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <emoji:TextBox x:Name="InputTextBox" Grid.Row="0" Grid.ColumnSpan="3" Margin="8,0,0,0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" BorderBrush="Transparent" FocusVisualStyle="{x:Null}" Template="{StaticResource BorderlessEmojiTextBoxTemplate}" MinHeight="93" MaxHeight="192" VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VerticalContentAlignment="Top" FontSize="14" Foreground="#172033" Background="Transparent" PreviewKeyDown="InputTextBox_OnPreviewKeyDown" DataObject.Pasting="InputTextBox_OnPasting"/>
          <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Grid Width="150" Height="31">
              <ToggleButton x:Name="ModelSelectorToggle" Width="150" Height="31" Style="{StaticResource AgentModelSelectorToggle}" IsChecked="{Binding IsModelMenuOpen, Mode=TwoWay}">
                <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="15" Padding="8,4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="◇" Foreground="#718096" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedModelLabel}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </ToggleButton>
              <Popup AllowsTransparency="True" Focusable="False" Placement="Top" PlacementTarget="{Binding ElementName=ModelSelectorToggle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsOpen="{Binding IsModelMenuOpen, Mode=TwoWay}" StaysOpen="False" VerticalOffset="-6" PopupAnimation="Fade">
                <Border Background="#FFFFFF" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="16" Padding="12" MinWidth="310" MaxWidth="400">
                  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AgentModelGroups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource AgentModelProviderLabel}"/>
                            <ItemsControl ItemsSource="{Binding Models}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Command="{Binding DataContext.SelectModelCommand, Source={x:Reference RootWindow}}" CommandParameter="{Binding}" Style="{StaticResource AgentModelMenuItem}">
                                    <StackPanel>
                                      <TextBlock Text="{Binding DisplayName}" Foreground="#273244" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                      <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ComboBox ItemsSource="{Binding AntigravityReasoningEfforts}" SelectedValuePath="Value" SelectedValue="{Binding AntigravityEffort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◇" ToolTip="推理强度" Visibility="{Binding IsAntigravityModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ComboBox ItemsSource="{Binding CodexReasoningEfforts}" SelectedValuePath="Value" SelectedValue="{Binding CodexEffort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◇" ToolTip="推理强度" Visibility="{Binding IsCodexModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding AntigravityApprovalPolicies}" SelectedValuePath="Value" SelectedValue="{Binding AntigravityApprovalPolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◈" ToolTip="审批策略" Visibility="{Binding IsAntigravityModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <ComboBox ItemsSource="{Binding CodexApprovalPolicies}" SelectedValuePath="Value" SelectedValue="{Binding CodexApprovalPolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◈" ToolTip="审批策略" Visibility="{Binding IsCodexModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <ComboBox ItemsSource="{Binding AntigravitySandboxModes}" SelectedValuePath="Value" SelectedValue="{Binding AntigravitySandboxMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◈" ToolTip="沙箱模式" Visibility="{Binding IsAntigravityModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <ComboBox ItemsSource="{Binding CodexSandboxModes}" SelectedValuePath="Value" SelectedValue="{Binding CodexSandboxMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="31" Margin="5,0,0,0" Style="{StaticResource InlineSelector}" Tag="◈" ToolTip="沙箱模式" Visibility="{Binding IsCodexModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,6,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" FontSize="12" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="发送  ↑" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" MinWidth="92"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Button Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource IconButton}" Background="#33000000" BorderThickness="0" Command="{Binding CloseDrawersCommand}" Visibility="{Binding IsProcessDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10"/>

    <Border Grid.Column="1" Grid.RowSpan="3" Width="380" HorizontalAlignment="Right" Background="#F8F9FB" BorderBrush="#DDE2E8" BorderThickness="1,0,0,0" Padding="18,22" Visibility="{Binding IsProcessDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="2,0,0,18"><TextBlock Text="Agent 过程" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/><Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseDrawersCommand}" Style="{StaticResource DrawerButton}" FontSize="22"/></DockPanel>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="协调层" FontWeight="SemiBold" Foreground="#273244"/>
            <TextBlock Text="{Binding MainConnectionLabel}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding MainProviderStatusDetail}" Foreground="#A16207" TextWrapping="Wrap" MaxHeight="54" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding ManagerCacheLabel}" Foreground="#64748B" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding ManagerContextLabel}" Foreground="#64748B" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding CurrentCodingDisplayName, StringFormat=代码层：{0} Coding Agent（按需启动）}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding CodingProviderStatusDetail}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
        <ListBox Grid.Row="2" ItemsSource="{Binding Activities}" ItemContainerStyle="{StaticResource DrawerListItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><Border Background="#FFFFFF" BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#273244" TextTrimming="CharacterEllipsis"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding Status}" Foreground="#738092" Margin="8,0,0,0"/><TextBlock Text="{Binding Runtime.DisplayLabel}" Foreground="#8A93A0" Margin="8,0,0,0"/></StackPanel></DockPanel><TextBlock Text="{Binding Details}" Foreground="#64748B" TextWrapping="Wrap" MaxHeight="110" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
