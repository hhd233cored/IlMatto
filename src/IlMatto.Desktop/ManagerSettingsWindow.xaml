<Window x:Class="IlMatto.Desktop.ManagerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · IlMatto Manager" Width="760" Height="700" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <ControlTemplate x:Key="NoHoverButtonTemplate" TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
    </ControlTemplate>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#273244"/>
      <Setter Property="BorderBrush" Value="#D8DEE7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template" Value="{StaticResource NoHoverButtonTemplate}"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Manager 设置" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="配置 Manager 的全局 Agent 运行选项、角色设定与工作区；旧会话保留历史记录但使用当前全局模型与运行策略" Foreground="#64748B" Margin="0,5,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="1" BorderThickness="0">
      <TabItem Header="主 Agent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="新对话默认主 Agent" FontWeight="SemiBold"/>
            <ComboBox x:Name="MainProviderBox" Margin="0,6,0,16">
              <ComboBoxItem Content="Antigravity CLI（新会话）" Tag="antigravity"/>
              <ComboBoxItem Content="OpenAI-compatible API" Tag="openai_compatible"/>
            </ComboBox>
            <GroupBox Header="Antigravity CLI（图片路径输入）" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="新建对话使用本机已登录的 Antigravity CLI。图片会由 IlMatto 保存到受管运行目录，并通过只读图片工具与问题一起发送；不会开放其他本地文件访问，也不在这里保存 API Key。" Foreground="#31567C" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Antigravity CLI 路径" FontWeight="SemiBold"/>
                <TextBox x:Name="AgyPathBox" Margin="0,6,0,12"/>
                <TextBlock Text="模型（留空使用 CLI 默认模型）" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="AgyModelBox" IsEditable="True" IsTextSearchEnabled="True"/>
                  <Button Grid.Column="1" Content="刷新 CLI 模型" Click="RefreshModelsButton_OnClick"/>
                </Grid>
                <TextBlock x:Name="AgyStatusText" Foreground="#64748B" FontSize="12" Margin="0,-6,0,10"/>
                <TextBlock Text="推理强度" FontWeight="SemiBold"/>
                <ComboBox x:Name="AgyEffortBox" Margin="0,6,0,12">
                  <ComboBoxItem Content="low"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="high"/>
                </ComboBox>
                <TextBlock Text="协调超时（当前不限制）" FontWeight="SemiBold"/>
                <TextBox x:Name="AgyTimeoutBox" Text="0" IsReadOnly="True" Margin="0,6,0,12"/>
                <Button Content="打开 CLI 登录终端" Click="AgyLoginButton_OnClick" HorizontalAlignment="Left"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="OpenAI-compatible 主 Agent" Padding="12">
              <StackPanel>
                <TextBlock Text="Base URL" FontWeight="SemiBold"/>
                <TextBox x:Name="MainApiBaseUrlBox" Margin="0,6,0,12"/>
                <TextBlock Text="模型 ID" FontWeight="SemiBold"/>
                <TextBox x:Name="MainApiModelIdBox" Margin="0,6,0,12"/>
                <TextBlock Text="API Key" FontWeight="SemiBold"/>
                <PasswordBox x:Name="MainApiKeyBox" Margin="0,6,0,12"/>
                <TextBlock Text="协调超时（秒）" FontWeight="SemiBold"/>
                <TextBox x:Name="MainApiTimeoutBox" Margin="0,6,0,10"/>
                <TextBlock Text="API 主 Agent 不获得工作区、代码、Diff 或工具，只能回答普通问题、澄清或委派。" Foreground="#31567C" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Coding Agent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="新对话默认 Coding Agent" FontWeight="SemiBold"/>
            <ComboBox x:Name="CodingProviderBox" Margin="0,6,0,16">
              <ComboBoxItem Content="Antigravity Coding Executor" Tag="antigravity"/>
              <ComboBoxItem Content="Pi Coding Agent" Tag="pi"/>
            </ComboBox>
            <GroupBox Header="Pi Coding Agent" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Base URL" FontWeight="SemiBold"/>
                <TextBox x:Name="PiBaseUrlBox" Margin="0,6,0,12"/>
                <TextBlock Text="模型 ID" FontWeight="SemiBold"/>
                <TextBox x:Name="PiModelIdBox" Margin="0,6,0,12"/>
                <TextBlock Text="API Key" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PiApiKeyBox" Margin="0,6,0,4"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="用户与头像">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="用户标识" FontWeight="SemiBold"/>
            <TextBlock Text="这个 ID 会显示在侧边栏顶部，并用于用户消息头像的默认文字。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <TextBox x:Name="UserIdBox" MaxLength="80" Margin="0,0,0,18"/>
            <GroupBox Header="用户头像" Padding="12" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="UserAvatarPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="留空使用用户 ID 首字作为头像"/>
                <Button Grid.Column="1" Content="选择图片" Click="BrowseUserAvatarButton_OnClick" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="清除" Click="ClearUserAvatarButton_OnClick" Margin="8,0,0,0"/>
              </Grid>
            </GroupBox>
            <GroupBox Header="Agent 头像" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="AgentAvatarPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="留空使用角色名首字作为头像"/>
                <Button Grid.Column="1" Content="选择图片" Click="BrowseAgentAvatarButton_OnClick" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="清除" Click="ClearAgentAvatarButton_OnClick" Margin="8,0,0,0"/>
              </Grid>
            </GroupBox>
            <TextBlock Text="头像会保存为应用本地的圆形透明 PNG；如果已保存的头像文件丢失，界面会自动回退到文字头像。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="角色设定">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="角色默认资料" FontWeight="SemiBold"/>
            <TextBlock Text="角色名和角色卡会复制到新对话；用户画像由应用本地 profile.md 维护并跨会话共享。不要在角色卡或 profile.md 中填写 API Key 或其他凭据。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,16"/>
            <TextBlock Text="角色名称" FontWeight="SemiBold"/>
            <TextBox x:Name="CompanionCharacterNameBox" MaxLength="80" Margin="0,6,0,4"/>
            <TextBlock Text="保存后会自动把角色名称插入角色卡开头；留空则使用“角色”。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Text="角色设定" FontWeight="SemiBold"/>
            <TextBox x:Name="CompanionCharacterPromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="210" MaxLength="8000" Margin="0,6,0,14"/>
            <TextBlock Text="每个 Manager 会话会将重要内容写入应用本地会话摘要；跨会话回忆默认只使用摘要，必要时才读取相关原文片段。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="界面与性能">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="聊天渲染模式" FontWeight="SemiBold"/>
            <CheckBox x:Name="FullChatRenderingBox" Content="完整渲染所有消息（调试模式）" Margin="0,8,0,0"/>
            <TextBlock Text="关闭时使用轻量空气泡虚拟化：只创建视口附近的消息外框，正文 Markdown、图片和过程内容暂不渲染。开启后恢复原来的完整消息渲染，适合对比布局、记录气泡尺寸或排查 Markdown 性能。修改后需要重启程序才能切换已创建的聊天列表。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,0"/>
            <Border Background="#FFF7DF" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,16,0,0">
              <TextBlock Text="环境变量 ILMATTO_CHAT_RENDER_MODE=full 或 =air 的优先级高于此设置，可用于一次性调试，不会修改设置文件。" TextWrapping="Wrap" Foreground="#805B12"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="工作区与安全">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,18,12,12">
            <TextBlock Text="新对话工作区" FontWeight="SemiBold"/>
            <Grid Margin="0,6,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="WorkspaceBox"/>
              <Button Grid.Column="1" Content="浏览" Click="BrowseButton_OnClick"/>
            </Grid>
            <CheckBox x:Name="SafeCommandsBox" Content="Pi：自动批准安全命令" Margin="0,3"/>
            <CheckBox x:Name="GitOperationsBox" Content="Pi：自动执行本地 Git 操作" Margin="0,6,0,0"/>
            <GroupBox Header="Browser MCP 权限" Padding="12" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="勾选后 Browser MCP 可直接使用对应能力；导航、点击、填写和按键默认允许。上传、下载、任意脚本与坐标输入默认关闭，开启前请确认页面和文件风险。" Foreground="#805B12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                  <CheckBox x:Name="BrowserNavigateBox" Content="允许页面导航" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserClickBox" Content="允许元素点击" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserFillBox" Content="允许填写输入框" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserPressBox" Content="允许元素按键" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserScrollBox" Content="允许页面滚动" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserScreenshotBox" Content="允许页面截图" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserUploadBox" Content="允许文件上传（高风险）" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserDownloadBox" Content="允许文件下载（高风险）" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserEvaluateBox" Content="允许任意 JavaScript / evaluate（高风险）" Margin="0,4,12,4"/>
                  <CheckBox x:Name="BrowserCoordinateBox" Content="允许坐标级鼠标键盘（高风险）" Margin="0,4,12,4"/>
                </UniformGrid>
              </StackPanel>
            </GroupBox>
            <TextBlock Text="Antigravity 编码执行权限" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <ComboBox x:Name="AgyExecutionPolicyBox" Margin="0,6,0,0">
              <ComboBoxItem Content="逐项审批" Tag="approval"/>
              <ComboBoxItem Content="常规测试预授权（需 AGY 规则）" Tag="safe_tests"/>
              <ComboBoxItem Content="工作区内自主执行" Tag="autonomous"/>
            </ComboBox>
            <TextBlock Text="Antigravity 使用统一会话执行对话与编码任务；模型回合不设应用层超时。所有 API Key 只保存在 Windows 凭据管理器。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Click="CancelButton_OnClick" MinWidth="84"/>
      <Button Content="保存设置" Click="SaveButton_OnClick" MinWidth="120" Background="#2563EB" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>
