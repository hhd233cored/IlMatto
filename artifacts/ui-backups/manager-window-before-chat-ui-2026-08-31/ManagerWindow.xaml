<Window x:Class="IlMatto.Desktop.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IlMatto.Desktop.Controls"
        Title="IlMatto · Agent Manager" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        Background="#F8FAFC" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="HistoryItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE8F7"/></Trigger></Style.Triggers>
    </Style>
    <!-- The manager transcript deliberately shares Pi's lightweight inline
         expander: a small chevron and text row, never a large circular
         button. Text and operation segments therefore read as one timeline. -->
    <Style x:Key="ProcessExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ToggleButton x:Name="HeaderToggle" Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Focusable="False">
                  <ContentPresenter ContentSource="Header"/>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Grid.Row="1" ContentSource="Content" Margin="0,5,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Menu Grid.Row="0" Background="#F4F7FA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
      <MenuItem Header="文件"><MenuItem Header="新对话" Command="{Binding NewSessionCommand}"/><Separator/><MenuItem Header="退出" Click="ExitMenuItem_OnClick"/></MenuItem>
      <MenuItem Header="视图"><MenuItem Header="Pi Coding 工作台" Command="{Binding OpenPiWorkbenchCommand}"/></MenuItem>
      <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}"/>
      <MenuItem Header="帮助"><MenuItem Header="关于 IlMatto"/></MenuItem>
    </Menu>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#EEF4FB" BorderBrush="#DCE4EE" BorderThickness="0,0,1,0">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="4,8,4,18"><TextBlock Text="IlMatto" FontSize="25" FontWeight="Bold" Foreground="#162033"/><TextBlock Text="{Binding CurrentProviderLabel}" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
          <Button Grid.Row="1" Content="＋  新对话" Command="{Binding NewSessionCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="13,10" Margin="0,0,0,12"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" ItemContainerStyle="{StaticResource HistoryItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><Grid Margin="9,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding ProviderLabel}" Foreground="#52657E" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedAt, StringFormat={} · {0:MM-dd HH:mm}}" Foreground="#7B8798" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Content="×" ToolTip="删除会话" Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#64748B" Padding="5,1"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="4,14,4,4"><Separator/><TextBlock Text="当前工作区" Foreground="#64748B" FontSize="12" Margin="0,10,0,3"/><TextBlock Text="{Binding WorkspaceLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}"/><Button Content="⚙  设置" Command="{Binding OpenSettingsCommand}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,10,0,0"/></StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#FFFFFF">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,0"><Grid><TextBlock Text="{Binding SelectedConversation.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding ManagerStatus}" Foreground="#64748B" VerticalAlignment="Center"/><Button Content="取消" Command="{Binding CancelCommand}" Margin="12,0,0,0"/></StackPanel></Grid></Border>
        <ScrollViewer x:Name="ManagerChatScrollViewer" Grid.Row="1" CanContentScroll="False" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,24" ScrollChanged="ManagerChatScrollViewer_OnScrollChanged" PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel">
          <ItemsControl ItemsSource="{Binding ChatEntries}" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" Background="#FFFFFF" MaxWidth="920" HorizontalAlignment="Stretch">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Role}" Value="你"><Setter Property="Background" Value="#EAF2FD"/><Setter Property="BorderBrush" Value="#D4E3F7"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="#415574" Margin="0,0,0,7"/>
                  <ItemsControl ItemsSource="{Binding Segments}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <local:MarkdownViewer Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" Markdown="{Binding Text}" Foreground="#172033" FontSize="14" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                          <Expander Visibility="{Binding HasVisibleOperations, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MaxWidth="900" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                            <Expander.Header>
                              <Grid MinHeight="22" MaxWidth="900" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LatestOperation.DisplayTitle}" Foreground="#6B7280" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420"/>
                                <TextBlock Grid.Column="2" Text="{Binding LatestOperation.CommandPreview}" ToolTip="{Binding LatestOperation.CommandLine}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding LatestOperation.Status}" Foreground="#9CA3AF" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                              </Grid>
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,4">
                              <TextBlock Text="{Binding LatestOperation.Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="900" HorizontalAlignment="Left"/>
                              <ItemsControl ItemsSource="{Binding PreviousOperations}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Expander Style="{StaticResource ProcessExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MaxWidth="900" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,2">
                                      <Expander.Header>
                                        <Grid MinHeight="22" MaxWidth="900" HorizontalAlignment="Left">
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                          <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                          <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="#6B7280" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420"/>
                                          <TextBlock Grid.Column="2" Text="{Binding CommandPreview}" ToolTip="{Binding CommandLine}" Foreground="#6B7280" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                          <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#9CA3AF" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                      </Expander.Header>
                                      <TextBlock Text="{Binding Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" MaxWidth="900" HorizontalAlignment="Left" Margin="0,4,0,4"/>
                                    </Expander>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Expander>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border x:Name="ResultCard" Background="#F8FAFC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CodeResult}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                      <DockPanel><TextBlock Text="Coding Agent 结果" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding CodeResult.StatusLabel}" Foreground="#2563EB"/></DockPanel>
                      <TextBlock Text="{Binding CodeResult.SummaryForUser}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      <ItemsControl ItemsSource="{Binding CodeResult.TechnicalDecisions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Decision}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <ItemsControl ItemsSource="{Binding CodeResult.FilesChanged}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Additions, StringFormat=+{0}}" Foreground="#07851C" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Deletions, StringFormat=-{0}}" Foreground="#DC2626" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <ItemsControl ItemsSource="{Binding CodeResult.Validation}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Command}" FontFamily="Consolas"/><TextBlock Text="{Binding Summary}" Foreground="#64748B"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <ItemsControl ItemsSource="{Binding CodeResult.Questions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#8A5B00"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Visibility="{Binding HasApproval, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFF8E6" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="28,6,28,8">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding CurrentApproval.Summary}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding PendingApprovalCountLabel}" Foreground="#A16207"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding CurrentApproval.Details}" Foreground="#64748B" TextWrapping="Wrap" MaxHeight="75" Margin="0,6,0,0"/><TextBlock Grid.Row="2" Text="{Binding CurrentApproval.Url}" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBox Grid.Row="3" Text="{Binding CurrentApproval.Diff}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0,8,0,0" Background="#FFFBEB"/><TextBox Grid.Row="4" Text="{Binding CurrentApproval.FieldsJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" MaxHeight="90" Margin="0,8,0,0" Background="#FFFDF5"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentApproval.RequiresInput}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBox Grid.Row="5" Text="{Binding InteractionResponseText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100" Margin="0,8,0,0" ToolTip="{Binding CurrentApproval.InputHint}"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentApproval.RequiresInput}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="拒绝" Command="{Binding RejectCommand}"/><Button Content="批准一次" Command="{Binding ApproveCommand}" Background="#2563EB" Foreground="White"/></StackPanel></Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="14" Margin="28,8,28,22" Padding="14" Background="#FFFFFF">
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" MinHeight="76" MaxHeight="180" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputTextBox_OnPreviewKeyDown"/><DockPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="{Binding CurrentProviderLabel}" Foreground="#7B8798" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="发送 ↑" Command="{Binding SendCommand}" Background="#2563EB" Foreground="White" MinWidth="88"/></DockPanel></Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#DCE4EE" BorderThickness="1,0,0,0">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Agent 过程" FontSize="17" FontWeight="SemiBold" Margin="2,9,0,14"/><Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,12"><StackPanel><TextBlock Text="协调层" FontWeight="SemiBold"/><TextBlock Text="{Binding MainConnectionLabel}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding MainProviderStatusDetail}" Foreground="#A16207" TextWrapping="Wrap" MaxHeight="54" Margin="0,3,0,0"/><TextBlock Text="{Binding ManagerCacheLabel}" Foreground="#64748B" Margin="0,3,0,0"/><TextBlock Text="{Binding ManagerContextLabel}" Foreground="#64748B" Margin="0,3,0,0"/><TextBlock Text="{Binding CurrentCodingDisplayName, StringFormat=代码层：{0} Coding Agent（按需启动）}" Foreground="#64748B" Margin="0,3,0,0"/><TextBlock Text="{Binding CodingProviderStatusDetail}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border><ListBox Grid.Row="2" ItemsSource="{Binding Activities}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#64748B" Margin="8,0,0,0"/></DockPanel><TextBlock Text="{Binding Details}" Foreground="#64748B" TextWrapping="Wrap" MaxHeight="110" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
